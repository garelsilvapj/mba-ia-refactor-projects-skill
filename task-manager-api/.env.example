# Copie para .env e ajuste. O .env real nunca é versionado.

# Chave de assinatura dos tokens de sessão. Gere uma nova:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

DATABASE_URL=sqlite:///tasks.db
DEBUG=false
HOST=127.0.0.1
PORT=5000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Validade do token em segundos (padrão: 8 horas)
TOKEN_MAX_AGE=28800

# Exigir token nas rotas protegidas.
# false (padrão): a API responde como antes da refatoração, sem autenticação.
# true: rotas passam a exigir Authorization: Bearer <token>. Recomendado fora de desenvolvimento.
REQUIRE_AUTH=false

# Notificações por e-mail. Sem SMTP_HOST/SMTP_USER o envio fica desativado
# e as notificações só são registradas em log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

LOG_LEVEL=INFO
