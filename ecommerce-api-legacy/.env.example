# Copie para .env e ajuste. O .env real nunca é versionado.

PORT=3000

# Caminho do banco SQLite. ':memory:' recria tudo a cada boot (comportamento original).
DB_FILE=:memory:

# Chave do gateway de pagamento. A chave que estava no código-fonte foi comprometida
# e deve ser rotacionada antes de qualquer uso.
PAYMENT_GATEWAY_KEY=

# Token das rotas administrativas (relatório financeiro e exclusão de usuário).
# Vazio: as rotas respondem como no comportamento original, sem autenticação.
# Preenchido: passam a exigir o cabeçalho X-Admin-Token. Recomendado fora de desenvolvimento.
ADMIN_TOKEN=

# Remetente das notificações (ainda não utilizado)
SMTP_USER=

# error | warn | info | debug
LOG_LEVEL=info
